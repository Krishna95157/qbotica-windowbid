# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by git and must never be shared, uploaded to the browser, or pasted into chats.

# Required for real plan reading. Create one at https://platform.openai.com/api-keys
# Leave empty to run in MOCK mode (uploads return a canned sample reading, no cost).
OPENAI_API_KEY=

# Vision-capable model used for extraction (OpenAI's docs currently recommend gpt-6-astra for new projects).
OPENAI_MODEL=gpt-6-astra

# How closely the model looks at the drawing: high | low | auto
OPENAI_IMAGE_DETAIL=high

# Drawing sets: detail for full-sheet reads ("original" keeps the full resolution; "high" shrinks every image to ~3k tokens)
# and for the quick page-sorting pass.
OPENAI_PAGE_DETAIL=original
OPENAI_CLASSIFY_DETAIL=high

# Optional: reasoning effort for reasoning models (e.g. low | medium | high). Leave empty if your model doesn't support it.
OPENAI_REASONING_EFFORT=

# Upper bound on the JSON the model may return (large plans need more).
OPENAI_MAX_OUTPUT_TOKENS=32000

# Server port and simple abuse protection for a public deployment.
PORT=3000
MAX_UPLOAD_MB=20
# Reading calls per visitor per hour. One drawing set uses about 10-15 (page sorting + plans + schedules).
EXTRACTIONS_PER_HOUR=200

# Force mock mode even when a key is set (1 = on), and how long a mock reading takes.
WB_MOCK=
WB_MOCK_SECONDS=12
